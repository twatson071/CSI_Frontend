# Demo Dockerfile with built-in dummy data and demo authentication
# Optimized for quick deployment with all dependencies included

# Stage 1: Build frontend
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

# Copy frontend package files
COPY CSI_UI/package.json CSI_UI/package-lock.json* ./
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

# Copy frontend source
COPY CSI_UI/ ./

# Build frontend with demo configuration
ENV VITE_BASE_URL=/api
ENV VITE_ALERT_SERVICE_URL=/socket.io
ENV VITE_DEMO_MODE=true
RUN node node_modules/vite/bin/vite.js build --mode production

# Stage 2: Build backend with demo data
FROM oven/bun:1-alpine AS backend-builder

# Install build dependencies
RUN apk add --no-cache python3 make g++ gcc libc-dev

WORKDIR /app/backend

# Copy backend package files
COPY CSI_API/package.json CSI_API/bun.lock ./
RUN bun install --frozen-lockfile

# Copy backend source
COPY CSI_API/ ./

# Build backend
RUN bun build ./src/index.ts --target=bun --outdir=./dist

# Stage 3: Production runtime with demo setup
FROM oven/bun:1-alpine AS production

# Install nginx, supervisor, and SQLite
RUN apk add --no-cache nginx supervisor curl sqlite

WORKDIR /app

# Copy backend files
COPY --from=backend-builder /app/backend/dist ./backend/dist
COPY --from=backend-builder /app/backend/node_modules ./backend/node_modules
COPY --from=backend-builder /app/backend/package.json ./backend/
# Copy source files needed for scripts and database setup
COPY CSI_API/src ./backend/src
COPY CSI_API/drizzle ./backend/drizzle
COPY CSI_API/scripts ./backend/scripts
COPY CSI_API/drizzle.config.ts ./backend/
COPY CSI_API/tsconfig.json ./backend/

# Copy frontend build
COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.production.conf /etc/nginx/http.d/default.conf

# Copy supervisor config for demo
COPY supervisord.demo.conf /etc/supervisord.conf

# Create directories for logs and data
RUN mkdir -p /var/log/supervisor /app/data

# Copy demo setup scripts
COPY demo-scripts/init-demo.sh /app/init-demo.sh
COPY demo-scripts/start-demo.sh /app/start-demo.sh
RUN chmod +x /app/init-demo.sh /app/start-demo.sh

# Environment variables for demo mode
ENV NODE_ENV=production
ENV DATABASE_URL=/app/data/demo.db
ENV DB_FILE_NAME=/app/data/demo.db
ENV PORT=4000
ENV BETTER_AUTH_URL=http://localhost:4000
ENV BETTER_AUTH_SECRET=demo-secret-key-for-testing-only
ENV DEMO_MODE=true
ENV ALLOW_DEMO_LOGIN=true
ENV EXTERNAL_BASE_URL=http://localhost:4000/mock
ENV SYSTEM_OPERATOR_KEY=demo-key
ENV HUB_KEY=demo-hub-key

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

# Start the application
CMD ["/app/start-demo.sh"]