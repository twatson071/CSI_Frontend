# Production Environment Configuration
# Copy this file to .env.production and update the values

# Application Settings
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=/app/data/production.db

# Authentication
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=your-very-secure-secret-key-change-this

# API Settings
API_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb

# Security
CORS_ORIGIN=http://localhost:8080
SESSION_SECRET=another-secure-secret-key

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# External Services (if needed)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password

# Monitoring (optional)
# SENTRY_DSN=https://your-sentry-dsn
# ENABLE_METRICS=true

# Feature Flags
ENABLE_DEVICE_POLLING=true
POLLING_INTERVAL=60000
ENABLE_ALERTS=true
ALERT_CHECK_INTERVAL=30000