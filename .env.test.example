# CSI Frontend Test Environment Configuration Template
# Copy this file to .env.test and adjust values as needed

# Backend Configuration (CSI_API/.env.test)
DB_FILE_NAME=test.db
EXTERNAL_BASE_URL=http://localhost:8090
SYSTEM_OPERATOR_KEY=TestSystemOperator-1
HUB_KEY=TestHub-1
NODE_ENV=test
PORT=3001

# CORS Configuration
CORS_ORIGIN=http://localhost:3002

# Optional Features
MOCK_EXTERNAL_SERVICE=true
LOG_LEVEL=info
REQUEST_TIMEOUT=30000

# Database Options
DB_LOG_QUERIES=false
DB_CONNECTION_LIMIT=10

# Security (Test Values - DO NOT USE IN PRODUCTION)
JWT_SECRET=test-jwt-secret-change-in-production
SESSION_SECRET=test-session-secret-change-in-production

# External Service Mock Configuration
MOCK_RESPONSE_DELAY=100
MOCK_ERROR_RATE=0

# Frontend Configuration (CSI_UI/.env.test)
VITE_API_URL=http://localhost:3001
VITE_APP_ENV=test
VITE_APP_VERSION=test-deployment
VITE_ENABLE_MOCK=false
VITE_LOG_LEVEL=info