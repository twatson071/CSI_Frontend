# Multi-stage Dockerfile for CSI production deployment
# This builds both frontend and backend, serving them from a single container

# Stage 1: Build frontend
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

# Copy frontend package files
COPY CSI_UI/package.json ./
RUN npm install --legacy-peer-deps

# Copy frontend source
COPY CSI_UI/ ./

# Build frontend (skip TypeScript checking for production)
RUN npx vite build

# Stage 2: Build backend
FROM oven/bun:1-alpine AS backend-builder

# Install build dependencies for native modules
RUN apk add --no-cache python3 make g++ gcc libc-dev

WORKDIR /app/backend

# Copy backend package files
COPY CSI_API/package.json CSI_API/bun.lock ./
RUN bun install --frozen-lockfile

# Copy backend source
COPY CSI_API/ ./

# Build backend (if TypeScript compilation is needed)
RUN bun build ./src/index.ts --target=bun --outdir=./dist

# Stage 3: Production runtime
FROM oven/bun:1-alpine AS production

# Install nginx and supervisor
RUN apk add --no-cache nginx supervisor curl

# Create app directory
WORKDIR /app

# Copy backend files
COPY --from=backend-builder /app/backend/dist ./backend/dist
COPY --from=backend-builder /app/backend/node_modules ./backend/node_modules
COPY --from=backend-builder /app/backend/package.json ./backend/
COPY CSI_API/drizzle ./backend/drizzle
COPY CSI_API/scripts ./backend/scripts

# Copy frontend build
COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.production.conf /etc/nginx/http.d/default.conf

# Copy supervisor config
COPY supervisord.conf /etc/supervisord.conf

# Create directories for logs and data
RUN mkdir -p /var/log/supervisor /app/data

# Environment variables
ENV NODE_ENV=production
ENV DATABASE_URL=/app/data/production.db
ENV PORT=3001
ENV BETTER_AUTH_URL=http://localhost:3001

# Expose ports
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

# Start supervisor to run both nginx and backend
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisord.conf"]