# Minimal production Dockerfile - expects pre-built assets
# Much faster to build and smaller image size

FROM nginx:alpine

# Install Node.js for API and supervisor for process management
RUN apk add --no-cache nodejs npm supervisor sqlite bash

WORKDIR /app

# Copy pre-built frontend to nginx
COPY CSI_UI/dist /usr/share/nginx/html

# Copy pre-built backend
COPY CSI_API/dist /app/backend/dist
COPY CSI_API/node_modules /app/backend/node_modules
COPY CSI_API/package.json /app/backend/
COPY CSI_API/drizzle /app/backend/drizzle
COPY CSI_API/scripts /app/backend/scripts

# Copy configurations
COPY nginx.production.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf /etc/supervisord.conf

# Create init script
RUN cat > /app/init.sh << 'EOF'
#!/bin/sh
if [ ! -f /app/data/demo.db ]; then
    cd /app/backend
    npm run migrate || true
    npm run seed || node scripts/seed-dummy-data.js || true
fi
exec /usr/bin/supervisord -n -c /etc/supervisord.conf
EOF

RUN chmod +x /app/init.sh && mkdir -p /app/data

# Environment
ENV NODE_ENV=production
ENV DATABASE_URL=/app/data/demo.db
ENV PORT=3001
ENV DEMO_MODE=true

EXPOSE 80

CMD ["/app/init.sh"]